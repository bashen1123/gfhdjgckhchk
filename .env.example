BOT_TOKEN=123456:replace_with_your_telegram_bot_token

# Optional API keys.
TRONGRID_API_KEY=
TONAPI_KEY=

# Optional proxy. Set one or more if this machine must go through a proxy.
# Examples:
# PROXY_API_URL=https://example.com/get_ip/your-token
# PROXY_URL=http://user:pass@host:port
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=http://127.0.0.1:7890
PROXY_API_URL=
PROXY_URL=
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
PROXY_REFRESH_SECONDS=300

# Runtime.
BOT_DB=bot.db
POLL_INTERVAL_SECONDS=60
HTTP_TIMEOUT_SECONDS=15
